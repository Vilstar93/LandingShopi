# ── Affiliate ──────────────────────────────────────────────────────────────
# Partner link for the Shopify affiliate account (Impact.com).
# The committed default lives in config/affiliate.json and works as-is.
# Set this only to repoint a deployment without a code change.
SHOPIFY_AFFILIATE_URL=

# Which Impact sub-ID parameter carries our click id.
SHOPIFY_AFFILIATE_SUBID_PARAM=subId1

# ── Intake ─────────────────────────────────────────────────────────────────
# Whether X-Forwarded-For may be trusted for rate limiting. The header is set
# by the caller, so trusting it on a directly reachable server lets one client
# send unlimited requests by changing it. Default: trusted only on Vercel
# (VERCEL=1), where the platform overwrites it. Set to 1 behind another proxy
# that does the same, or 0 to force socket addresses.
# TRUST_PROXY=

# Where submitted requests are forwarded. Any endpoint that accepts a JSON POST.
# Empty means requests are only recorded locally.
#
# On a deployed portal this is REQUIRED. Serverless filesystems are read-only
# apart from a per-invocation /tmp, so the local log does not survive.
REQUEST_WEBHOOK_URL=

# Where the local request log is written. Defaults to ./data/
# REQUEST_LOG_DIR=

# ── OpenClaw agent ─────────────────────────────────────────────────────────
# The portal posts each accepted request to the agent, which then starts
# building the store config.
#
#   POST <OPENCLAW_URL><OPENCLAW_HOOK_PATH>   with  Authorization: Bearer <token>
#
# Both the URL and the token must be set for the bridge to be active. A URL
# alone does nothing, so a half-finished setup cannot send unauthenticated
# traffic.
OPENCLAW_URL=
OPENCLAW_TOKEN=

# /hooks/agent starts an isolated agent turn (preferred).
# /hooks/wake  enqueues an event for the main session.
OPENCLAW_HOOK_PATH=/hooks/agent

# now | next-heartbeat
OPENCLAW_MODE=now
