# Partner URL from the Shopify affiliate account (Impact.com).
# Format: https://shopify.pxf.io/<id>-link?sharedid=<id>
# Leave empty and the portal runs normally, but no Shopify button is shown.
SHOPIFY_AFFILIATE_URL=

# Optional: where submitted requests are forwarded.
# Any endpoint that accepts a JSON POST. Leave empty to skip forwarding.
REQUEST_WEBHOOK_URL=
